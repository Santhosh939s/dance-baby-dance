rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Make sure the user is authenticated and the uid matches the document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow the user to access their own subcollections
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
